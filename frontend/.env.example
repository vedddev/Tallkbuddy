# Vite development proxy target. The browser uses same-origin /api and /ws paths.
VITE_BACKEND_URL=http://127.0.0.1:8000
# Optional same-origin public base URL for a reverse-proxied deployment.
VITE_API_BASE_URL=

# Experimental periodic Whisper snapshots; OFF unless cost and browser behavior are verified.
VITE_INTERIM_CAPTIONS_ENABLED=false
VITE_INTERIM_INTERVAL_MS=1800
