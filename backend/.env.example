APP_NAME=TalkBuddy API
APP_ENV=development
LOG_LEVEL=INFO
# These two Vite origins are allowed automatically in development; list other trusted origins here.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Production: use one public HTTPS origin serving frontend plus reverse-proxied /api and /ws.
# PUBLIC_ORIGIN=https://talkbuddy.example
DATABASE_URL=postgresql+asyncpg://talkbuddy_user:replace-with-password@localhost:5432/talkbuddy_db

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_COMMAND_TIMEOUT_SECONDS=15
# Set TEST_DATABASE_URL only in the test shell; use a separate database whose name includes "test".
AUTH_SESSION_DAYS=7
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=60
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE defaults to true in production and false in development.
GROQ_API_KEY=your_groq_api_key_here
GROQ_TRANSLATION_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=2
# Optional Azure translated-speech WAV output. Set both values privately when enabled.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=
AZURE_TTS_ENABLED=false
TTS_TIMEOUT_SECONDS=20
TTS_MAX_AUDIO_BYTES=2097152
AI_MAX_AUDIO_BYTES=10485760
AI_MAX_TEXT_CHARS=5000
AI_MAX_CONCURRENT_PROVIDER_CALLS=8
AI_PROVIDER_QUEUE_TIMEOUT_SECONDS=5
WS_MAX_AUDIO_BYTES=1048576
WS_MAX_CONTROL_BYTES=2048
WS_MAX_CONNECTIONS_PER_USER=2
WS_MAX_CHUNKS=100
WS_IDLE_TIMEOUT_SECONDS=60
WS_PROCESSING_TIMEOUT_SECONDS=120
